      "path": ".github/agents/paper-analyst.agent.md"
    },
    {
      "name": "code-inspector",
      "path": ".github/agents/code-inspector.agent.md"
    },
    {
      "name": "report-writer",
      "path": ".github/agents/report-writer.agent.md"
    }
  ],
  "prompts": [
    {
      "name": "analyze-full",
      "path": ".github/prompts/analyze-full.prompt.md"
    },
    {
      "name": "analyze-batch",
      "path": ".github/prompts/analyze-batch.prompt.md"
